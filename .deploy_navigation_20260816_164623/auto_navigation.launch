<?xml version="1.0"?>
<launch>
    <!-- 自动导航启动文件 -->
    
    <!-- 参数配置 -->
    <arg name="auto_execute" default="true" />
    <arg name="goal_timeout" default="30.0" />
    <arg name="max_retries" default="3" />
    <arg name="goal_tolerance" default="0.1" />
    <arg name="max_queue_size" default="25" />
    <arg name="referee_material_topic" default="/all_Material_Number" />
    <arg name="arrived_material_topic" default="/arrived_material_number" />
    <arg name="material_arrive_tolerance" default="0.1" />
    <arg name="material_wait_duration" default="1.5" />
    <arg name="material_scan_target_topic" default="/material_scan_target" />
    <arg name="material_scan_switch_delay" default="3.0" />
    <arg name="switch_model_on_route_complete" default="true" />
    <arg name="model_switch_topic" default="/switch_model" />
    <arg name="route_complete_model" default="light_det" />
    <arg name="shooting_mode_topic" default="/shooting_mode" />
    <arg name="current_model_topic" default="/current_model" />
    <arg name="model_switch_timeout" default="15.0" />
    <arg name="slope_mode_enabled" default="true" />
    <arg name="slope_test_bypass_safety" default="false" />
    <arg name="slope_start_x" default="1.30" />
    <arg name="slope_start_y" default="2.07" />
    <arg name="slope_end_x" default="2.83" />
    <arg name="slope_end_y" default="2.05" />
    <arg name="slope_heading_yaw" default="0.01" />
    <arg name="slope_linear_speed" default="0.5" />
    <arg name="slope_alignment_linear_speed" default="0.1" />
    <arg name="slope_max_curvature" default="2.0" />
    <arg name="slope_scan_forward_angle" default="3.14159" />
    <arg name="slope_goal_tolerance" default="0.05" />
    <arg name="slope_route_match_tolerance" default="0.015" />
    <arg name="slope_takeover_max_pose_age" default="1.0" />
    <arg name="slope_takeover_max_position_error" default="0.2" />
    <arg name="slope_takeover_max_heading_error" default="0.5" />
    
    <!-- 返航基地坐标参数 -->
    <arg name="base_x" default="0" />
    <arg name="base_y" default="0" />
    <arg name="base_yaw" default="0" />
    
    <!-- 启动自动导航节点 -->
    <node name="auto_navigation_node" pkg="auto_navigation" type="auto_navigation_node.py" output="screen">
        <param name="auto_execute" value="$(arg auto_execute)" />
        <param name="goal_timeout" value="$(arg goal_timeout)" />
        <param name="max_retries" value="$(arg max_retries)" />
        <param name="goal_tolerance" value="$(arg goal_tolerance)" />
        <param name="max_queue_size" value="$(arg max_queue_size)" />
        <param name="referee_material_topic" value="$(arg referee_material_topic)" />
        <param name="arrived_material_topic" value="$(arg arrived_material_topic)" />
        <param name="material_arrive_tolerance" value="$(arg material_arrive_tolerance)" />
        <param name="material_wait_duration" value="$(arg material_wait_duration)" />
        <param name="material_scan_target_topic" value="$(arg material_scan_target_topic)" />
        <param name="material_scan_switch_delay" value="$(arg material_scan_switch_delay)" />
        <param name="switch_model_on_route_complete" value="$(arg switch_model_on_route_complete)" />
        <param name="model_switch_topic" value="$(arg model_switch_topic)" />
        <param name="route_complete_model" value="$(arg route_complete_model)" />
        <param name="shooting_mode_topic" value="$(arg shooting_mode_topic)" />
        <param name="current_model_topic" value="$(arg current_model_topic)" />
        <param name="model_switch_timeout" value="$(arg model_switch_timeout)" />
        <param name="slope_mode_enabled" value="$(arg slope_mode_enabled)" />
        <param name="slope_test_bypass_safety" value="$(arg slope_test_bypass_safety)" />
        <param name="slope_start_x" value="$(arg slope_start_x)" />
        <param name="slope_start_y" value="$(arg slope_start_y)" />
        <param name="slope_end_x" value="$(arg slope_end_x)" />
        <param name="slope_end_y" value="$(arg slope_end_y)" />
        <param name="slope_heading_yaw" value="$(arg slope_heading_yaw)" />
        <param name="slope_linear_speed" value="$(arg slope_linear_speed)" />
        <param name="slope_alignment_linear_speed" value="$(arg slope_alignment_linear_speed)" />
        <param name="slope_max_curvature" value="$(arg slope_max_curvature)" />
        <param name="slope_scan_forward_angle" value="$(arg slope_scan_forward_angle)" />
        <param name="slope_goal_tolerance" value="$(arg slope_goal_tolerance)" />
        <param name="slope_route_match_tolerance" value="$(arg slope_route_match_tolerance)" />
        <param name="slope_takeover_max_pose_age" value="$(arg slope_takeover_max_pose_age)" />
        <param name="slope_takeover_max_position_error" value="$(arg slope_takeover_max_position_error)" />
        <param name="slope_takeover_max_heading_error" value="$(arg slope_takeover_max_heading_error)" />
        
        <!-- 返航基地坐标 -->
        <param name="base_x" value="$(arg base_x)" />
        <param name="base_y" value="$(arg base_y)" />
        <param name="base_yaw" value="$(arg base_yaw)" />
    </node>
    
    <!-- 启动目标发布器；等待裁判物资点后从 Roads/ 选最优路径并整表入队 -->
    <group if="$(arg auto_execute)">
        <node name="goal_publisher" pkg="auto_navigation" type="goal_publisher.py" output="screen">
            <param name="max_queue_size" value="$(arg max_queue_size)" />
            <param name="referee_material_topic" value="$(arg referee_material_topic)" />
        </node>
    </group>
    
    <!-- 启动RViz可视化（可选）
    <group if="false">
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(find auto_navigation)/config/navigation.rviz" />
    </group> -->
    
</launch>
